# ---- PayPal Sandbox ----
# Create a Sandbox app at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Optional: a Sandbox test card (generated from your own PayPal Sandbox
# account under Testing Tools > Generate credit cards) lets the agent
# authorize a payment directly, without a buyer browser redirect.
# If left blank, AgentAuth falls back to the standard PayPal Checkout
# approve-link flow.
PAYPAL_TEST_CARD_NUMBER=
PAYPAL_TEST_CARD_EXPIRY=
PAYPAL_TEST_CARD_CVV=
PAYPAL_TEST_CARD_NAME=

# ---- OpenRouter (OpenAI-compatible) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Database ----
DATABASE_URL=sqlite:///./agentauth.db

# ---- Audit integrity ----
AUDIT_HMAC_SECRET=change-me-to-a-long-random-string

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000
