# ---- PayPal Sandbox ----
# Create a Sandbox app at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Optional: a Sandbox test card (generated from your own PayPal Sandbox
# account under Testing Tools > Generate credit cards) lets the agent
# authorize a payment directly, without a buyer browser redirect.
# If left blank, Auctara falls back to the standard PayPal Checkout
# approve-link flow.
PAYPAL_TEST_CARD_NUMBER=
PAYPAL_TEST_CARD_EXPIRY=
PAYPAL_TEST_CARD_CVV=
PAYPAL_TEST_CARD_NAME=

# ---- Groq (OpenAI-compatible) ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Channel3 (real-time product discovery for agentic commerce) ----
# Create a free account at https://trychannel3.com/sign-up/developer (1,000
# free searches/month). Used by the procurement agent to find real products
# with live price/retailer/availability data instead of scraping pages.
CHANNEL3_API_KEY=

# ---- Database ----
DATABASE_URL=sqlite:///./auctara.db

# ---- Audit integrity ----
# A long, random secret used to HMAC-chain the audit log. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_SECRET=

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Agent Operations Schedule ----
# true (default): this process polls for due scheduled tasks and fires them
# itself. Simplest, correct for a single-instance deployment (what this
# project runs in dev and in its live demo).
# false: a separate `python worker.py` process does the polling instead
# (see render.yaml for why that requires more than flipping this flag on
# a platform where services don't share a filesystem).
RUN_SCHEDULER_INPROCESS=true
